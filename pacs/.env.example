# Copy to .env and edit. `docker compose` reads it automatically.

# ---------------------------------------------------------------- Orthanc (PACS)
# AE title the scanners send to (their "called AE"). Orthanc rejects other called AEs.
ORTHANC_AET=ASVANTA
# DICOM port published on the host. Open it in the firewall ONLY from the modality VLAN.
ORTHANC_DICOM_PORT=4242
# Interface the DICOM port binds to (0.0.0.0 = all; set to the LAN IP to restrict).
ORTHANC_DICOM_BIND=0.0.0.0
# Orthanc REST/DICOMweb is published on 127.0.0.1 only, for debugging (never expose it).
ORTHANC_HTTP_DEBUG_PORT=8042
# Credentials the gateway uses for Orthanc's REST API (Orthanc HTTP basic auth). CHANGE THE PASSWORD.
ORTHANC_USER=gateway
ORTHANC_PASSWORD=change-me-orthanc
# false (default): only scanners registered via /api/pacs/scanners may C-STORE.
# true: accept any calling AE (commissioning only).
ORTHANC_ACCEPT_UNKNOWN=false
# true: a registered AE must also come from its registered IP/host.
ORTHANC_CHECK_MODALITY_HOST=false
# true: verbose Orthanc logs.
ORTHANC_VERBOSE=false

# ---------------------------------------------------------------- Gateway (FastAPI)
GATEWAY_BIND=0.0.0.0
GATEWAY_PORT=8000
# IP/hostname of this server on the hospital LAN. GET /api/pacs shows it so staff know what to configure on scanners.
PACS_PUBLIC_HOST=
# SQLite database (inside the gateway container; on the gateway-data volume).
DB_PATH=/data/gateway.db
# Password for all seeded demo users (priya@asvanta.in, dr.mehta@asvanta.in, ...). CHANGE IT.
DEMO_PASSWORD=asvanta
# Login session lifetime in hours.
SESSION_HOURS=12
# Allowed browser origins for the web app (comma separated).
CORS_ORIGINS=http://localhost:5173,http://localhost:5179
# Seconds between polls of Orthanc's /changes feed.
INGEST_INTERVAL=3

# ---------------------------------------------------------------- Sharing / SMS
# Centre name at the start of every SMS (keep it short and ASCII: one 160-char segment).
CENTRE_NAME=Asvanta Diagnostics
# Base URL of the web app as seen from the recipient's phone. Links are <PUBLIC_BASE_URL>/#/s/<token>.
PUBLIC_BASE_URL=http://localhost:5173
# console: no SMS is sent; messages go to the outbox (GET /api/dev/outbox). msg91 | twilio: real SMS.
SMS_PROVIDER=console
# MSG91 (India). Needs a DLT-registered template; its variables are ##centre## ##what## ##modality##
# ##bodypart## ##link## ##otp## ##hours##.
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER=
# Twilio.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
